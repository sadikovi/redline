# client


def http_call(port, token, method, path, body=None, timeout=30):
    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
    try:
        headers = {"Authorization": "Bearer " + token}
        data = None
        if method in ("POST", "PATCH"):
            data = json.dumps(body or {}).encode("utf-8")
            headers["Content-Type"] = "application/json"
        conn.request(method, path, body=data, headers=headers)
        resp = conn.getresponse()
        return resp.status, resp.getheader("Content-Type", ""), resp.read()
    finally:
        conn.close()


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


class Client:
    def __init__(self, repo):
        self.repo = repo
        self.info_path = os.path.join(repo.state_dir, "server.json")
        self.info = None

    def _responding(self, info):
        if not isinstance(info, dict) or not pid_alive(info.get("pid", 0)):
            return False
        try:
            status, _, _ = http_call(info["port"], info["token"], "GET", "/api/ping", timeout=3)
        except (OSError, KeyError, http.client.HTTPException):
            return False
        return status == 200

    def running(self):
        info = read_json(self.info_path)
        return info if self._responding(info) else None

    def ensure(self):
        """Return server info, starting a detached server if none is responding."""
        os.makedirs(self.repo.state_dir, mode=0o700, exist_ok=True)
        with open(os.path.join(self.repo.state_dir, "server.lock"), "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            info = self.running()
            if info:
                self.info = info
                return info
            log = open(os.path.join(self.repo.state_dir, "server.log"), "ab")
            proc = subprocess.Popen([sys.executable, SCRIPT, "serve"], cwd=self.repo.top,
                                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=log, start_new_session=True, close_fds=True)
            log.close()
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                info = read_json(self.info_path)
                if isinstance(info, dict) and info.get("pid") == proc.pid and self._responding(info):
                    self.info = info
                    return info
                if proc.poll() is not None:
                    break
                time.sleep(0.05)
            raise ReviewError("server failed to start (see %s)"
                              % os.path.join(self.repo.state_dir, "server.log"))

    def call(self, method, path, body=None, timeout=60, retry=True):
        info = self.info or self.ensure()
        try:
            status, ctype, raw = http_call(info["port"], info["token"], method, path, body, timeout)
        except (OSError, http.client.HTTPException):
            if not retry:
                raise
            self.info = None
            info = self.ensure()
            status, ctype, raw = http_call(info["port"], info["token"], method, path, body, timeout)
        if ctype.startswith("application/json"):
            data = json.loads(raw.decode("utf-8"))
        else:
            data = raw.decode("utf-8")
        if status >= 400:
            msg = data.get("error") if isinstance(data, dict) else data
            raise ReviewError(msg or "HTTP %d" % status)
        return data


def cmd_wait(client, timeout):
    deadline = time.monotonic() + timeout
    while True:
        remaining = max(0, int(deadline - time.monotonic()))
        try:
            return client.call("GET", "/api/wait?timeout=%d" % remaining,
                               timeout=remaining + 30, retry=False)
        except (OSError, http.client.HTTPException):
            if time.monotonic() >= deadline:
                return "TIMEOUT"
            client.info = None
            time.sleep(0.2)
            client.ensure()


def cmd_stop(client):
    info = client.running()
    if info:
        try:
            http_call(info["port"], info["token"], "POST", "/api/shutdown", {}, timeout=5)
        except (OSError, http.client.HTTPException):
            pass
        deadline = time.monotonic() + 5
        while pid_alive(info["pid"]) and time.monotonic() < deadline:
            time.sleep(0.05)
    return "stopped"


def main(argv=None):
    ap = argparse.ArgumentParser(prog="review", description="Local GitHub-style code review loop.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("start", help="start or resume a review")
    p.add_argument("ref", nargs="?")
    p.add_argument("--title")
    p.add_argument("--no-open", action="store_true")
    p.add_argument("--new", action="store_true")
    p = sub.add_parser("wait", help="wait for the reviewer to submit")
    p.add_argument("--timeout", type=int, default=DEFAULT_WAIT)
    sub.add_parser("push", help="reply to comments (stdin) and push a new round")
    sub.add_parser("commit", help="commit the approved snapshot; message from stdin")
    sub.add_parser("status", help="show the current review")
    sub.add_parser("end", help="archive the review and delete its refs")
    sub.add_parser("serve", help="run the server in the foreground")
    sub.add_parser("stop", help="stop the server")
    args = ap.parse_args(argv)

    try:
        repo = Repo()
        if args.cmd == "serve":
            serve(repo)
            return 0
        client = Client(repo)
        if args.cmd == "stop":
            out = cmd_stop(client)
        elif args.cmd == "start":
            out = client.call("POST", "/api/start",
                              {"ref": args.ref, "title": args.title, "new": args.new})
            if not args.no_open:
                webbrowser.open(out.rsplit(" ", 1)[-1])
        elif args.cmd == "wait":
            out = cmd_wait(client, max(args.timeout, 0))
            print(out)
            return 2 if out == "TIMEOUT" else 0
        elif args.cmd == "push":
            out = client.call("POST", "/api/push", {"text": sys.stdin.read()}, timeout=600)
        elif args.cmd == "commit":
            out = client.call("POST", "/api/commit", {"message": sys.stdin.read()}, timeout=600)
        elif args.cmd == "status":
            out = client.call("GET", "/api/status")
        else:
            out = client.call("POST", "/api/end")
        print(out)
        return 0
    except ReviewError as e:
        print("error: %s" % str(e).replace("\n", " "), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
